# Используется интеграционными тестами (apps/api) и GitHub Actions.
# Реальный .env.test не коммитить — CI генерирует его временно из GitHub Actions service container.
APP_PROFILE=local
NODE_ENV=test

API_PORT=3100
WEB_PORT=5273
WEB_ORIGINS=http://localhost:5273
VITE_API_URL=http://localhost:3100

AUTH_PROVIDER=local
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=test-secret-please-generate-32-bytes-min
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=developer@pamagochi.local

STORAGE_PROVIDER=filesystem
LOCAL_STORAGE_PATH=.data/storage-test
LOCAL_STORAGE_SIGNING_SECRET=test-secret-please-generate-32-bytes-min

JOB_PROVIDER=inline

POSTGRES_PORT=5433
POSTGRES_USER=pamagochi_test
POSTGRES_PASSWORD=pamagochi_test
POSTGRES_DB=pamagochi_test
DATABASE_URL=postgresql://pamagochi_test:pamagochi_test@localhost:5433/pamagochi_test
DIRECT_DATABASE_URL=postgresql://pamagochi_test:pamagochi_test@localhost:5433/pamagochi_test
