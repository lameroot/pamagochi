# Root template for voice-agent related secrets and selectors.
# Copy into `.env.local` / cloud secret stores. Never commit real values.
# See docs/credentials.md and docs/adr/0001-livekit-and-application-boundaries.md

# --- Provider selectors (canonical) ---
VOICE_STT_PROVIDER=deepgram
VOICE_LLM_PROVIDER=deepseek
VOICE_TTS_PROVIDER=elevenlabs

# --- LiveKit (server-only: apps/api + apps/voice-agent) ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=pamagochi-voice-agent

# --- Deepgram STT ---
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# --- DeepSeek LLM (OpenAI-compatible adapter; do NOT use OPENAI_* names) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.65
DEEPSEEK_MAX_OUTPUT_TOKENS=350
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_RETRIES=2

# --- ElevenLabs TTS ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.20
ELEVENLABS_USE_SPEAKER_BOOST=true

# --- Internal voice-agent <-> api ---
VOICE_AGENT_INTERNAL_API_URL=http://localhost:3000/internal/agent
VOICE_AGENT_SERVICE_TOKEN=your-voice-agent-service-token-min-32-chars

# --- Soul / safety versions ---
PAMAGOCHI_SOUL_VERSION=0.1.0
PAMAGOCHI_SAFETY_POLICY_VERSION=0.1.0

# --- Privacy / memory ---
TRANSCRIPT_STORAGE_ENABLED=true
AUDIO_RECORDING_ENABLED=false
MEMORY_EXTRACTION_ENABLED=true
MEMORY_MAX_ACTIVE_ITEMS=15
MEMORY_MIN_CONFIDENCE=0.80

# --- Cost / session limits ---
VOICE_SESSION_MAX_DURATION_SECONDS=1800
VOICE_SESSION_IDLE_TIMEOUT_SECONDS=120
VOICE_MAX_TURNS_PER_MINUTE=20
VOICE_MAX_OUTPUT_TOKENS_PER_TURN=350
VOICE_MAX_TTS_CHARACTERS_PER_SESSION=30000
VOICE_MAX_STT_SECONDS_PER_SESSION=1800
VOICE_MAX_CONCURRENT_SESSIONS_PER_CHILD=1
VOICE_DAILY_BUDGET_USD_PER_CHILD=1.00
VOICE_GLOBAL_DAILY_BUDGET_USD=25.00

# Frontend apps (game/parent) must NOT receive any of the secret keys above.
# Game gets LIVEKIT_URL + short-lived room token only via bootstrap API.
