APP_PROFILE=local
NODE_ENV=development

API_PORT=3000
WEB_PORT=5173
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
VITE_API_URL=http://localhost:3000
VITE_APP_PROFILE=local

AUTH_PROVIDER=local
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=replace-with-at-least-32-random-bytes
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=developer@pamagochi.local

STORAGE_PROVIDER=filesystem
LOCAL_STORAGE_PATH=.data/storage
LOCAL_STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes

JOB_PROVIDER=inline

POSTGRES_PORT=5432
POSTGRES_USER=pamagochi
POSTGRES_PASSWORD=pamagochi
POSTGRES_DB=pamagochi
DATABASE_URL=postgresql://pamagochi:pamagochi@localhost:5432/pamagochi
DIRECT_DATABASE_URL=postgresql://pamagochi:pamagochi@localhost:5432/pamagochi

# --- Voice agent / LiveKit (server-only; never VITE_*) ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=pamagochi-voice-agent
VOICE_AGENT_SERVICE_TOKEN=your-voice-agent-service-token-min-32-chars
VOICE_AGENT_INTERNAL_API_URL=http://localhost:3000/internal/agent
VOICE_STT_PROVIDER=deepgram
VOICE_LLM_PROVIDER=deepseek
VOICE_TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PAMAGOCHI_SOUL_VERSION=0.1.0
PAMAGOCHI_SAFETY_POLICY_VERSION=0.1.0
TRANSCRIPT_STORAGE_ENABLED=true
AUDIO_RECORDING_ENABLED=false
MEMORY_EXTRACTION_ENABLED=true
VOICE_SESSION_MAX_DURATION_SECONDS=1800
VOICE_SESSION_IDLE_TIMEOUT_SECONDS=120
VOICE_MAX_CONCURRENT_SESSIONS_PER_CHILD=1
