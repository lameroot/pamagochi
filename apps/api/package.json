    "@fastify/static": "9.3.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@pamagochi/contracts": "workspace:*",
    "@pamagochi/database": "workspace:*",
    "@pamagochi/game-core": "workspace:*",
