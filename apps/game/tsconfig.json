{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-types",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@*/contracts": ["../../packages/contracts/dist/index.d.ts"],
      "@*/game-protocol": ["../../packages/game-protocol/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
